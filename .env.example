# Browser/build-time: Supabase project Connect dialog > Project URL and publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server runtime: same project and public key. Never use an administrative key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional: retain the existing Lovable preview auth broker only for its own project.
# VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
# Security tests ONLY, in an isolated test project; never prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=SERVER_SIDE_TEST_ADMIN_KEY
# LOOP_SECURITY_TEST_PROJECT_URL=https://YOUR_ISOLATED_PROJECT.supabase.co
